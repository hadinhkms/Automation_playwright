# ==============================================================================
# VIỆC LÀM 24H AUTOMATION - CẤU HÌNH MÔI TRƯỜNG (.env)
# Sao chép file này thành .env và điền các thông tin tương ứng trên máy tính của bạn
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH AI PROVIDER & API KEYS
# ------------------------------------------------------------------------------
# Nhà cung cấp AI mặc định cho AI Agent & Inline Suggestion.
# Giá trị hỗ trợ: gemini (khuyên dùng), openai, deepseek
AI_PROVIDER=gemini

# Google Gemini API Key
# Đăng ký và lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Tùy chọn - điền nếu AI_PROVIDER=openai)
OPENAI_API_KEY=

# DeepSeek API Key (Tùy chọn - điền nếu AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Mô hình AI sử dụng (Tùy chọn, để trống sẽ dùng mặc định)
# - Gemini: gemini-2.5-flash (mặc định), gemini-flash-lite-latest (siêu nhanh, tiết kiệm token)
# - OpenAI: gpt-4o-mini
# - DeepSeek: deepseek-chat
AI_MODEL=gemini-2.5-flash

# Base URL tùy chỉnh cho AI API (Tùy chọn - chỉ dùng khi qua proxy hoặc reverse gateway nội bộ)
# AI_BASE_URL=

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DASHBOARD SERVER
# ------------------------------------------------------------------------------
# Cổng chạy Automation Dashboard (mặc định: 4174)
DASHBOARD_PORT=4174

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MÔI TRƯỜNG TEST PLAYWRIGHT
# ------------------------------------------------------------------------------
# Môi trường chạy test mặc định: qc (Quality Control), stg (Staging), prod (Production)
NODE_ENV=qc

# Discord Webhook URL để nhận thông báo kết quả test tự động (Tùy chọn)
# Xem chi tiết cấu hình tại: docs/DISCORD_BOT_SETUP_GUIDE.md
# DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. CHẾ ĐỘ PHÁT TRIỂN FRAMEWORK (DÀNH CHO TÁC GIẢ / MAINTAINER)
# ------------------------------------------------------------------------------
# false: Chế độ người dùng kiểm thử (Tài liệu framework bị khóa chỉ đọc, bảo vệ khỏi can thiệp nhầm)
# true:  Chế độ nhà phát triển (Cho phép cập nhật và chỉnh sửa tài liệu framework)
FRAMEWORK_DEV_MODE=false
# FRAMEWORK_DEV_TOKEN=lead_developer

