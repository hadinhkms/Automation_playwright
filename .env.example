# ==============================================================================
# QA AUTOMATION ENGINE (HUB) - CẤU HÌNH MÔI TRƯỜNG (.env)
# Sao chép file này thành .env và điền các thông tin tương ứng trên máy tính của bạn
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH AI PROVIDER & API KEYS
# ------------------------------------------------------------------------------
# Nhà cung cấp AI mặc định cho AI Agent & Inline Suggestion.
# Giá trị hỗ trợ: gemini (khuyên dùng), openai, deepseek
AI_PROVIDER=gemini

# Google Gemini API Key
# Đăng ký và lấy key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Tùy chọn - điền nếu AI_PROVIDER=openai)
OPENAI_API_KEY=

# DeepSeek API Key (Tùy chọn - điền nếu AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=

# Mô hình AI sử dụng (Tùy chọn, để trống sẽ dùng mặc định)
# - Gemini: gemini-2.5-flash (mặc định), gemini-flash-lite-latest (siêu nhanh, tiết kiệm token)
# - OpenAI: gpt-4o-mini
# - DeepSeek: deepseek-chat
AI_MODEL=gemini-2.5-flash

# Base URL tùy chỉnh cho AI API (Tùy chọn - chỉ dùng khi qua proxy hoặc reverse gateway nội bộ)
# AI_BASE_URL=

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH DASHBOARD SERVER
# ------------------------------------------------------------------------------
# Cổng chạy Automation Dashboard (mặc định: 4174)
DASHBOARD_PORT=4174

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MÔI TRƯỜNG TEST PLAYWRIGHT
# ------------------------------------------------------------------------------
# Môi trường chạy test mặc định: qc (Quality Control), stg (Staging), prod (Production)
NODE_ENV=qc

# Discord Webhook URL để nhận thông báo kết quả test tự động (Tùy chọn)
# Xem chi tiết cấu hình tại: docs/DISCORD_BOT_SETUP_GUIDE.md
# DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. CHẾ ĐỘ PHÁT TRIỂN FRAMEWORK (DÀNH CHO TÁC GIẢ / MAINTAINER)
# ------------------------------------------------------------------------------
# false: Chế độ người dùng kiểm thử (Tài liệu framework bị khóa chỉ đọc, bảo vệ khỏi can thiệp nhầm)
# true:  Chế độ nhà phát triển (Cho phép cập nhật và chỉnh sửa tài liệu framework)
FRAMEWORK_DEV_MODE=false
# FRAMEWORK_DEV_TOKEN=lead_developer

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH JIRA CLOUD API (TÍCH HỢP ĐỌC TICKET JIRA)
# ------------------------------------------------------------------------------
# Token được tạo tại: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://sieuviet.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=


# ------------------------------------------------------------------------------
# 6. NATIVE ANDROID (APPIUM + WEBDRIVERIO) - xem docs/ANDROID_NATIVE_TESTING.md
# ------------------------------------------------------------------------------
# Đường dẫn file APK (tuyệt đối hoặc tương đối từ thư mục repo). Bỏ trống nếu app đã cài sẵn.
ANDROID_APP_PATH=
# Serial của máy thật/emulator lấy từ `npm run android:devices`. Bỏ trống nếu chỉ cắm 1 máy.
ANDROID_UDID=
# Dùng khi app đã cài sẵn trên máy (không cài lại từ APK)
# ANDROID_APP_PACKAGE=com.example.app
# ANDROID_APP_ACTIVITY=.MainActivity
# true = giữ data app giữa các lần chạy (không clear/cài lại)
# Mặc định: false khi có APK, true khi chỉ dùng ANDROID_APP_PACKAGE
# ANDROID_NO_RESET=false
ANDROID_AUTO_GRANT_PERMISSIONS=true
# Appium server: mặc định test tự khởi động Appium ở 127.0.0.1:4723.
# Đặt APPIUM_EXTERNAL=true nếu bạn tự chạy `appium` ở terminal khác.
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_EXTERNAL=false

# ------------------------------------------------------------------------------
# 7. NATIVE iOS (APPIUM TRÊN MÁY MAC TỪ XA) - xem _Plan_implement/mobile-app-studio/phase-3-ios-remote-mac.md
# ------------------------------------------------------------------------------
# Appium 2 + driver xcuitest chạy trên máy macOS có Xcode. Dashboard chỉ kết nối tới, không tự khởi động.
# Ví dụ: IOS_APPIUM_HOST=http://192.168.1.20  (bỏ trống cho tới khi có máy Mac)
IOS_APPIUM_HOST=
IOS_APPIUM_PORT=4723
# Danh sách thiết bị iOS dạng JSON. simulator=true cho simulator, false cho iPhone thật.
# IOS_DEVICES=[{"name":"iPhone 15","platformVersion":"17.5","udid":"","simulator":true}]
IOS_DEVICES=
# App cần test: đường dẫn .app/.ipa TRÊN MÁY MAC hoặc URL http(s). Hoặc dùng bundle id của app đã cài.
IOS_APP=
IOS_BUNDLE_ID=
# Chỉ cần khi chạy trên iPhone thật (ký WebDriverAgent). Không lưu mật khẩu Apple ID ở đây.
IOS_XCODE_ORG_ID=
IOS_WDA_BUNDLE_ID=
